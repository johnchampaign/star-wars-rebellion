<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" width="640" height="360" viewBox="0 0 640 360">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#0a0a1a;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#1a1a2e;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#16213e;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="glow" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#0f3460;stop-opacity:0.3" />
      <stop offset="100%" style="stop-color:#0f3460;stop-opacity:0" />
    </linearGradient>
    <filter id="neon">
      <feGaussianBlur stdDeviation="2" result="blur"/>
      <feMerge>
        <feMergeNode in="blur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
    <filter id="softGlow">
      <feGaussianBlur stdDeviation="4" result="blur"/>
      <feMerge>
        <feMergeNode in="blur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
  </defs>

  <!-- Background -->
  <rect width="640" height="360" fill="url(#bg)"/>

  <!-- Stars -->
  <g fill="#ffffff" opacity="0.6">
    <circle cx="50" cy="30" r="1.2"/>
    <circle cx="120" cy="80" r="0.8"/>
    <circle cx="200" cy="20" r="1.5"/>
    <circle cx="300" cy="60" r="0.6"/>
    <circle cx="400" cy="40" r="1.0"/>
    <circle cx="500" cy="90" r="0.7"/>
    <circle cx="580" cy="50" r="1.3"/>
    <circle cx="80" cy="150" r="0.5"/>
    <circle cx="180" cy="200" r="1.1"/>
    <circle cx="350" cy="180" r="0.9"/>
    <circle cx="450" cy="130" r="0.6"/>
    <circle cx="550" cy="220" r="1.0"/>
    <circle cx="30" cy="280" r="0.8"/>
    <circle cx="150" cy="310" r="1.2"/>
    <circle cx="250" cy="270" r="0.7"/>
    <circle cx="380" cy="300" r="1.4"/>
    <circle cx="490" cy="260" r="0.5"/>
    <circle cx="600" cy="320" r="0.9"/>
    <circle cx="620" cy="150" r="0.6"/>
    <circle cx="100" cy="340" r="1.0"/>
    <circle cx="320" cy="130" r="0.4"/>
    <circle cx="530" cy="170" r="0.8"/>
    <circle cx="70" cy="220" r="0.6"/>
    <circle cx="440" cy="340" r="1.1"/>
    <circle cx="280" cy="340" r="0.5"/>
  </g>

  <!-- Nebula glow -->
  <ellipse cx="320" cy="180" rx="250" ry="120" fill="url(#glow)" opacity="0.4"/>

  <!-- Planet -->
  <g transform="translate(320, 180)">
    <!-- Planet shadow/atmosphere -->
    <circle cx="0" cy="0" r="65" fill="#0f3460" opacity="0.3" filter="url(#softGlow)"/>

    <!-- Planet body -->
    <circle cx="0" cy="0" r="55" fill="#1a1a2e" stroke="#0f3460" stroke-width="1.5"/>

    <!-- Planet surface details -->
    <ellipse cx="-15" cy="-10" rx="20" ry="12" fill="#16213e" opacity="0.6"/>
    <ellipse cx="20" cy="15" rx="15" ry="8" fill="#16213e" opacity="0.4"/>
    <ellipse cx="-5" cy="20" rx="10" ry="6" fill="#16213e" opacity="0.5"/>

    <!-- Planet highlight -->
    <ellipse cx="-20" cy="-20" rx="25" ry="18" fill="#ffffff" opacity="0.04"/>

    <!-- Ring system -->
    <ellipse cx="0" cy="0" rx="85" ry="18" fill="none" stroke="#0f3460" stroke-width="2" opacity="0.5" transform="rotate(-20)"/>
    <ellipse cx="0" cy="0" rx="78" ry="14" fill="none" stroke="#16213e" stroke-width="1.5" opacity="0.3" transform="rotate(-20)"/>
  </g>

  <!-- Grid lines -->
  <g stroke="#0f3460" stroke-width="0.5" opacity="0.15">
    <line x1="0" y1="90" x2="640" y2="90"/>
    <line x1="0" y1="180" x2="640" y2="180"/>
    <line x1="0" y1="270" x2="640" y2="270"/>
    <line x1="160" y1="0" x2="160" y2="360"/>
    <line x1="320" y1="0" x2="320" y2="360"/>
    <line x1="480" y1="0" x2="480" y2="360"/>
  </g>

  <!-- Corner accents -->
  <g stroke="#0f3460" stroke-width="2" opacity="0.6">
    <polyline points="20,20 50,20 50,25" fill="none"/>
    <polyline points="20,20 20,50 25,50" fill="none"/>
    <polyline points="620,20 590,20 590,25" fill="none"/>
    <polyline points="620,20 620,50 615,50" fill="none"/>
    <polyline points="20,340 50,340 50,335" fill="none"/>
    <polyline points="20,340 20,310 25,310" fill="none"/>
    <polyline points="620,340 590,340 590,335" fill="none"/>
    <polyline points="620,340 620,310 615,310" fill="none"/>
  </g>

  <!-- System label placeholder -->
  <g transform="translate(320, 310)">
    <rect x="-80" y="-12" width="160" height="24" rx="3" fill="#1a1a2e" stroke="#0f3460" stroke-width="1" opacity="0.8"/>
    <text x="0" y="5" font-family="'Orbitron', sans-serif" font-size="12" fill="#0f3460" text-anchor="middle" letter-spacing="3" opacity="0.7">SYSTEM</text>
  </g>

  <!-- Status indicator dots -->
  <g>
    <circle cx="30" cy="180" r="3" fill="#0f3460" opacity="0.5"/>
    <circle cx="610" cy="180" r="3" fill="#0f3460" opacity="0.5"/>
  </g>

  <!-- Aspect ratio marker -->
  <g opacity="0.08">
    <text x="320" y="350" font-family="monospace" font-size="10" fill="#ffffff" text-anchor="middle">16:9</text>
  </g>
</svg>