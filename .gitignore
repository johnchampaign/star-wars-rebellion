node_modules
dist
.DS_Store
*.log
.vite

# Secrets
.env
.env.local
.env.*.local

# Local extracted .vmod (we re-extract from source)
vmod_extracted/
map_tiles/

# Local-only dev assets (regenerated by scripts/copy-dev-assets.mjs).
# Use the dir/* form rather than dir/ so the negations below can
# re-include specific files (git ignores re-includes if a parent
# directory is excluded with the trailing-slash form).
public/dev-assets/*
# Exception: the unit-token sheet + per-unit token PNGs are AUTHOR-ORIGINAL
# art (not FFG-derived). They ship in the deploy via the strip-images
# whitelist, so they need to be tracked in git.
!public/dev-assets/unit-tokens-sheet.png
!public/dev-assets/units
public/dev-assets/units/*
!public/dev-assets/units/token
public/dev-assets/units/token/*
!public/dev-assets/units/token/*.png

# Live game-state dumps (vite dev plugin output — not for sharing)
game-logs/

# Local copies of problem reports. The canonical copies live as GitHub
# Issues (created by the /api/report Function or vite dev middleware).
# Disk backups stay out of the repo.
reports/

# Local-only play-log mirrors. Real uploads live in logs/<hash>.json
# committed to the deploy repo by /api/upload-logs.
logs/

# TypeScript incremental-build artifacts.
*.tsbuildinfo

# FFG-copyrighted source materials — kept locally for development
# reference only. DO NOT commit these. Anyone working on the project
# brings their own copies.
*.vmod
sw03_learn_to_play_web.pdf
sw03_rules_reference_web.pdf
StarWarsRebellion_v2.5.pdf
Star_Wars_Rebellion_-_Important_Card_Reference_v1.1.pdf
Star_Wars_Rebellion_Leader_Skill_Chart_v1.pdf
SWR_Mission_Reference.pdf
MissionReference_RotE_Final.pdf
MissionReference.docx
Rebel_Leader_Action_Cards.docx
Imperial_Leader_Action_Cards.docx
REBEL_OBJ.pdf
Combat_Cards.pdf
Rebellion_v3.xlsx
OSD-*BattleMatGuide*.pdf
OSD-*.pdf

# Loose images / scratch assets that shouldn't ship
e96cd17d-*.png
map_hires.png
map_orig.png
tournament-logs/
# Scratch directory for ad-hoc extracts (.vmod inspection, screenshot
# downloads, etc.) — anything dropped here is local-only.
tmp/
# Ad-hoc analysis dir (downloaded play logs for offline inspection).
logs-tmp/
