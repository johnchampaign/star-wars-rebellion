# Local-dev env vars for vite middleware (vite.config.ts).
# Copy to .env (which is gitignored) and fill in real values to enable
# /api/report and /api/upload-logs to file real GitHub Issues + commits
# during `npm run dev`. Leave blank to fall back to local-disk saving.
#
# Production uses the same names as Cloudflare Pages Environment Variables
# (Settings → Environment variables in the CF dashboard) — see docs/deploy.md.

# GitHub Personal Access Token with `repo` scope (or `public_repo` if the
# target repo is public). Generate at https://github.com/settings/tokens.
SWR_BUGREPORT_TOKEN=

# Repo to file issues / commit screenshots / commit game logs against.
# Format: "owner/repo"
SWR_BUGREPORT_REPO=johnchampaign/star-wars-rebellion

# Optional: dedicated repo for play logs. Falls back to SWR_BUGREPORT_REPO
# when unset. Useful if you want a separate logs-only repo.
# SWR_LOGS_REPO=
